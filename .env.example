# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development

# ── Web (frontend) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_INVITE_REQUIRED=false

# ── API ────────────────────────────────────────────────
API_PORT=3010
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepprompt

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=please_replace_with_a_32_chars_secret
JWT_REFRESH_SECRET=please_replace_with_another_32_chars_secret
INVITE_REQUIRED=false

# ── R2 Object Storage ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deepprompt-assets
R2_PUBLIC_URL=https://assets.deepprompt.ai

# ── Meilisearch ────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=deepprompt-dev-master-key

# ── OAuth (reserved) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
