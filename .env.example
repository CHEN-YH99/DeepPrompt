# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development

# ── Web (frontend) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN
NEXT_PUBLIC_INVITE_REQUIRED=false

# ── API ────────────────────────────────────────────────
API_PORT=3010
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deepprompt

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 启动时若 JWT_SECRET / JWT_REFRESH_SECRET 缺失或长度 < 32 服务会 fail-fast，不允许 fallback。
JWT_SECRET=please_replace_with_a_32_chars_secret
JWT_REFRESH_SECRET=please_replace_with_another_32_chars_secret
INVITE_REQUIRED=false

# ── Captcha (Cloudflare Turnstile) ─────────────────────
# 申请：https://dash.cloudflare.com/?to=/:account/turnstile
# dev 环境（NODE_ENV !== production）未配置时自动放行；
# prod 环境未配置 TURNSTILE_SECRET_KEY 且 TURNSTILE_DISABLED!=true 会启动失败。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── R2 Object Storage ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deepprompt-assets
R2_PUBLIC_URL=https://assets.deepprompt.ai

# ── Meilisearch ────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=deepprompt-dev-master-key

# ── OAuth (reserved) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
